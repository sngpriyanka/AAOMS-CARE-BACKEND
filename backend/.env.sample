# ==================== SERVER CONFIGURATION ====================
PORT=Your preferred port (default: 5000)
NODE_ENV= Your environment (development or production)

# ==================== JWT AUTHENTICATION ====================
# Generate a strong secret key for production!
JWT_SECRET=your_jwt_secret_key
# Login token duration when "Remember Me" is checked (default: 7d)
JWT_REMEMBER_EXPIRES_IN=7d
# Login token duration for a normal session without "Remember Me" (default: 1d)
JWT_SESSION_EXPIRES_IN=1d

# ==================== CORS CONFIGURATION ====================
# Local: http://localhost:3000
# Production (HostingRaja): https://aaoms.co.in
FRONTEND_URL=https://aaoms.co.in

# ==================== DATABASE CONFIGURATION (PostgreSQL / Neon) ====================
DATABASE_URL=your_neon_postgres_connection_string

# ==================== RAZORPAY PAYMENT GATEWAY ====================
# Dashboard → Account & Settings → API Keys
# https://dashboard.razorpay.com/app/keys
# Use Test keys for development (rzp_test_...) and Live keys (rzp_live_...) in production.
# Key Secret stays ONLY on the backend — never put it in the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email Service (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@aaoms.com

# ==================== LOCAL FILE UPLOADS (Multer disk — Cloudinary NOT used for products) ====================
# Product images go to: $UPLOADS_DIR/products/
#
# Local development:
# UPLOADS_DIR=uploads
#
# HostingRaja / VPS (aaoms.co.in) — use ABSOLUTE path:
UPLOADS_DIR=/var/www/aa081045-940d-4f8d-9804-973fa48b1d99/aaoms-data/uploads
#
# Folders auto-created: profile, products, categories, videos, banners, testimonials, gallery, documents
# Product API: POST /api/upload/product-images  (field: files)
# PostgreSQL stores ONLY: /uploads/products/<filename>
#
BACKEND_PUBLIC_URL=https://aaoms.co.in

# Cloudinary keys UNUSED for product images (code is commented in utils/cloudinaryConfig.js).
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ==================== API RATE LIMITING ====================
# Limit requests to prevent abuse
RATE_LIMIT_WINDOW=15 # in minutes
RATE_LIMIT_MAX_REQUESTS=100 # max requests per window per IP

# ==================== LOGGING ====================
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log

# Email Configuration (Gmail)
SMTP_SERVICE=gmail
SMTP_MAIL=your-email@gmail.com
SMTP_PASS=your-app-password
# Admin inbox for new order alerts (comma-separated for multiple recipients)
ADMIN_EMAIL=admin@aaoms.com

# ==================== SMS OTP (Indian mobile / NinzaSMS) ====================
# Login OTP + profile phone OTP.
# Params: api_key, sender_id, mobile/to, message
SMS_API_KEY=your_ninzasms_api_key
SMS_SENDER_ID=16025
# Exact send URL from NinzaSMS dashboard → API Documentation
SMS_API_URL=https://ninzasms.in.net/api/sms
SMS_API_METHOD=GET
SMS_PROVIDER=ninzasms
SMS_OTP_MESSAGE_TEMPLATE=Your OTP is {otp}
# Set to false to skip mobile OTP on email/password login (Google auth is never gated by this)
LOGIN_OTP_ENABLED=true
LOGIN_OTP_CHALLENGE_EXPIRES_IN=10m

# ==================== SPARROW SMS API (legacy optional fallback) ====================
# Used only when SMS_API_URL is empty and SPARROW_TOKEN is set
SPARROW_TOKEN=your_sparrow_api_token
SPARROW_SENDER=AAOMS

# ==================== Google Auth ====================
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
