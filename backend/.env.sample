# ==================== SERVER CONFIGURATION ====================
PORT=Your preferred port (default: 5000)
NODE_ENV= Your environment (development or production)

# ==================== JWT AUTHENTICATION ====================
# Generate a strong secret key for production!
JWT_SECRET=your_jwt_secret_key
# Login token duration when "Remember Me" is checked (default: 7d)
JWT_REMEMBER_EXPIRES_IN=7d
# Login token duration for a normal session without "Remember Me" (default: 1d)
JWT_SESSION_EXPIRES_IN=1d

# ==================== CORS CONFIGURATION ====================
FRONTEND_URL=your_frontend_url (e.g., http://localhost:3000)

# ==================== DATABASE CONFIGURATION (PostgreSQL / Neon) ====================
DATABASE_URL=your_neon_postgres_connection_string

# ==================== RAZORPAY PAYMENT GATEWAY ====================
# Dashboard → Account & Settings → API Keys
# https://dashboard.razorpay.com/app/keys
# Use Test keys for development (rzp_test_...) and Live keys (rzp_live_...) in production.
# Key Secret stays ONLY on the backend — never put it in the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email Service (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@aaoms.com

# ==================== CLOUDINARY IMAGE & VIDEO UPLOAD ====================
# Get your credentials from: https://cloudinary.com/console
# Free tier includes: 25 GB storage, 25 GB monthly bandwidth
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== API RATE LIMITING ====================
# Limit requests to prevent abuse
RATE_LIMIT_WINDOW=15 # in minutes
RATE_LIMIT_MAX_REQUESTS=100 # max requests per window per IP

# ==================== LOGGING ====================
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log

# Email Configuration (Gmail)
SMTP_SERVICE=gmail
SMTP_MAIL=your-email@gmail.com
SMTP_PASS=your-app-password
# Admin inbox for new order alerts (comma-separated for multiple recipients)
ADMIN_EMAIL=admin@aaoms.com

# ==================== SPARROW SMS API ====================
SPARROW_TOKEN=your_sparrow_api_token
# Use the sender identity approved in your Sparrow SMS dashboard (Demo works for this account)
SPARROW_SENDER=AAOMS

# ==================== Google Auth ====================
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
